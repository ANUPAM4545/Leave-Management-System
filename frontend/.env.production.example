# ============================================
# Vercel Frontend Environment Variables
# ============================================
# Set this in Vercel dashboard under Project Settings > Environment Variables

# Backend API URL (Your Railway backend URL)
# Example: https://your-backend.railway.app
VITE_API_URL=https://your-backend.railway.app

# ============================================
# Instructions:
# ============================================
# 1. Go to Vercel dashboard
# 2. Select your project
# 3. Go to Settings > Environment Variables
# 4. Add VITE_API_URL with your Railway backend URL
# 5. Make sure to add it for Production, Preview, and Development environments
# 6. Redeploy after adding environment variables
